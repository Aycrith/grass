# .env.example — Mission 1 (Largo Lawn) web app
#
# Copy to .env.local (gitignored) and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser; everything
# else is server-only.

# --- Synthetic mode ---------------------------------------------------
# Set to 1 to force all server-side integrations (Twilio, GA4 MP,
# Meta CAPI) to log their would-be payloads to
# `output/synthetic-events.jsonl` instead of calling the real APIs.
# This is the DEFAULT when keys are missing. Useful for local dev
# and end-to-end pipeline testing without a real Twilio/GA4/Meta
# account. NEVER set in production.
# SYNTHETIC_MODE=1

# --- Business identity (single source of truth) -----------------------
# Changing the name or domain is a one-line edit. Every page,
# JSON-LD field, sitemap, robots.txt, email template, and SMS
# template reads from these.
# NEXT_PUBLIC_BUSINESS_NAME=Largo Lawn
# NEXT_PUBLIC_LEGAL_ENTITY=Largo Lawn
# NEXT_PUBLIC_SITE_URL=https://largolawn.pro

# Google Business Profile direct review URL. Format:
#   https://search.google.com/local/writereview?placeid=<PLACE_ID>
# Where <PLACE_ID> comes from the GBP dashboard once the profile
# is verified (postcard arrives 5-7 days after claim). When set,
# the ContactForm success state shows a "leave a review" callout
# on the pet-waste landing page. Empty by default — review-ask
# card is silently hidden until the URL is set.
# NEXT_PUBLIC_GBP_REVIEW_URL=

# --- Google Analytics 4 + Google Ads (Fix #8) -----------------------
# Get these from analytics.google.com (GA4) and ads.google.com (Ads).
# Format examples: G-ABC123DEF4 / AW-9876543210
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# GA4 API secret (server-side Measurement Protocol). Create in
# GA4 Admin → Data Streams → your stream → Measurement Protocol
# API secrets. NEVER commit this value.
GA4_API_SECRET=

# --- Meta Pixel + Conversions API (Fix #9) -------------------------
# Get the pixel ID from business.facebook.com → Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# Long-lived system-user access token. Generate in Meta Business
# Settings → System Users → your system user → Generate Token
# with `ads_management` + `business_management` scopes. NEVER
# commit this value.
META_ACCESS_TOKEN=
# Optional. When set, every CAPI event is flagged as a test event
# (visible in Events Manager → Test Events). Remove for production.
META_PIXEL_TEST_EVENT_CODE=

# --- Twilio (Fix #6, V2 opt-in) ----------------------------------
# V1 lead notifications default to email (Gmail SMTP, free). To
# switch the notify path to Twilio auto-text-back, set
# LEAD_NOTIFY_MODE=twilio below AND fill these three vars. The
# trial account can only send to verified caller IDs, so this is
# development-only until you upgrade.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164-format verified sender (the business number).
TWILIO_FROM_NUMBER=+17273138011
# Trial-account Content template SID (auto-reply text). When the
# trial account gates the API on this, the lead route will surface
# a clear error in the response. Leave blank to use body text
# (only works on paid accounts).
TWILIO_CONTENT_SID=

# --- Lead notify mode (V1: email; V2: twilio) --------------------
# Decides which backend the /api/lead route uses to ping the
# operator about a new lead. Defaults to "auto" — email if
# configured, else twilio if configured, else synthetic log.
# Set explicitly when you want to force a specific channel.
# LEAD_NOTIFY_MODE=auto

# --- Gmail SMTP (V1 lead notifications — DEFAULT) ----------------
# Free, $0 forever, no third-party account. Generate the app
# password at myaccount.google.com → Security → App passwords.
# Requires 2FA enabled on the Gmail account first.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional. Where the lead-notification email is sent. Defaults
# to GMAIL_USER when unset (the operator's own inbox).
# LEAD_NOTIFY_TO=44thefool44@gmail.com

# --- CallRail (Fix #3 — deferred, not yet active) -----------------
# NEXT_PUBLIC_CALLRAIL_NUMBER=
# CALLRAIL_WEBHOOK_SECRET=
