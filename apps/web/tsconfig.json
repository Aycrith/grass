{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "incremental": false,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@grass/constitution/*": ["../../constitution/*"],
      "@grass/governance/*": ["../../governance/*"],
      "@grass/architecture/*": ["../../architecture/*"],
      "@grass/agents/*": ["../../agents/*"],
      "@grass/state/*": ["../../state/*"],
      "@grass/knowledge/*": ["../../knowledge/*"],
      "@grass/research/*": ["../../research/*"],
      "@grass/analytics/*": ["../../analytics/*"],
      "@grass/audit/*": ["../../audit/*"],
      "@grass/platform/*": ["../../platform/*"],
      "@grass/auth": ["../../platform/packages/auth/src/index.ts"],
      "@grass/auth/*": ["../../platform/packages/auth/src/*"],
      "@grass/crm-core": ["../../platform/packages/crm-core/src/index.ts"],
      "@grass/crm-core/*": ["../../platform/packages/crm-core/src/*"],
      "@grass/payments-core": ["../../platform/packages/payments-core/src/index.ts"],
      "@grass/payments-core/*": ["../../platform/packages/payments-core/src/*"],
      "@grass/scheduling-core": ["../../platform/packages/scheduling-core/src/index.ts"],
      "@grass/scheduling-core/*": ["../../platform/packages/scheduling-core/src/*"],
      "@grass/notifications-core": ["../../platform/packages/notifications-core/src/index.ts"],
      "@grass/notifications-core/*": ["../../platform/packages/notifications-core/src/*"],
      "@grass/database": ["../../platform/packages/database/src/index.ts"],
      "@grass/database/*": ["../../platform/packages/database/src/*"]
    },
    "allowJs": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
