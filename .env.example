# ===================================================================
# GRASS .env.example — SECRETS CONTRACT
# Copy to .env and fill in real values. NEVER commit .env.
# Real values stored in 1Password CLI vault "GRASS".
#
# Charter principle: "Documentation before memory."
# This file documents every secret the org will ever need.
# Update this file FIRST when adding a new external dependency.
# ===================================================================

# --- Phase 0 — none yet -----------------------------------------
# (no secrets until Day 8+ when external services are wired up)

# --- Phase 1 — governance tooling --------------------------------
GH_TOKEN=                       # gh CLI authentication
                                # Permission scopes: repo, read:org, workflow
                                # Used by: charter-compliance scripts,
                                #          capability-registry PR creation,
                                #          decision-template issue creation

# --- Phase 2 — knowledge platform (Month 1-2) --------------------
SUPABASE_URL=                   # https://<project>.supabase.co
SUPABASE_ANON_KEY=              # Public — safe in browser
SUPABASE_SERVICE_ROLE_KEY=      # Server-only — never in browser
                                # Bypass RLS for admin operations
POSTGRES_URL=                   # Direct Postgres connection (for migrations)
                                # postgresql://postgres:<password>@<host>:5432/postgres

# --- Phase 3 — research engine (Month 2) -------------------------
GOOGLE_PLACES_API_KEY=          # GBP optimization + competitor research
OPENAI_API_KEY=                 # or chosen LLM provider for research agents
ANTHROPIC_API_KEY=              # Claude Code, possibly MCP tools

# --- Phase 4 — agent orchestration (Month 3) ---------------------
INNGEST_EVENT_KEY=              # or Vercel Cron + QStash alt
INNGEST_SIGNING_KEY=            # for webhook verification

# --- Phase 5 — core platform (Month 3-4) --------------------------
NEXT_PUBLIC_APP_URL=            # https://app.grass.example.com
RESEND_API_KEY=                 # transactional email
EMAIL_FROM=                     # verified sender e.g. hello@grass.example.com
TWILIO_ACCOUNT_SID=             # SMS dispatch + review-request
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # +1813XXXXXXX
STRIPE_SECRET_KEY=              # sk_live_...
STRIPE_WEBHOOK_SECRET=          # whsec_...  (from stripe webhook endpoint)
STRIPE_PUBLISHABLE_KEY=         # pk_live_...  (NEXT_PUBLIC_ variant below)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MAPBOX_ACCESS_TOKEN=            # routing + geocoding

# --- Phase 6 — shared services hardening (Month 4-6) -------------
SENTRY_DSN=                     # error tracking
AXIOM_TOKEN=                    # logs
POSTHOG_API_KEY=                # product analytics + KPI dashboards
NEXT_PUBLIC_POSTHOG_API_KEY=    # public (safe in browser)
POSTHOG_HOST=                   # https://us.i.posthog.com

# --- Phase 7+ — SEO + marketing automation (Month 4+) ------------
AHREFS_API_KEY=                 # or SE Ranking alt
BRIGHTLOCAL_API_KEY=            # citation tracking + GBP sync
GBP_API_KEY=                    # Google Business Profile API (if used)

# --- Operator app (Months 0-6) -----------------------------------
JOBBER_API_KEY=                 # admin app — see Day-2 plan: don't build admin first
JOBBER_SUBDOMAIN=

# --- Local dev toggles --------------------------------------------
NODE_ENV=development
BUN_ENV=development
